# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
E2B_API_KEY=e2b_...

# ── Optional ──────────────────────────────────────────────────────────────────
LOGFIRE_TOKEN=
LLM_MODEL=openai:gpt-4o
REDIS_URL=redis://localhost:6379
CHROMA_HOST=                    # leave blank for local PersistentClient; set to "chromadb" in Docker
CHROMA_PORT=8001
CORS_ORIGINS=http://localhost:3000
